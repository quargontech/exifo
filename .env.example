# Copy to .env.local for local builds. On Vercel, set these in Project Settings → Environment Variables.
# Both are inlined at build time: rebuild or redeploy after changing them.

# Canonical site URL used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://exifo.app

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to build without analytics.
NEXT_PUBLIC_GA_ID=
